# ==============================================================================
# Bitcoin Transaction Intelligence & Investigation Platform - .gitignore
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Node & Frontend
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables & Credentials
.env
.env*.local
!.env.example

# IDE & Editors
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# OS Specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Databases & Analytical Caches
*.duckdb
*.duckdb.wal
*.duckdb.tmp
neo4j_data/
neo4j_logs/
.ipynb_checkpoints/

# Data Directories (Preserve structure with .gitkeep, ignore generated datasets)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/features/*
!data/features/.gitkeep
data/ground_truth/*
!data/ground_truth/.gitkeep

# Models & Reports (Preserve directory structure)
models/*
!models/.gitkeep
reports/*
!reports/.gitkeep
